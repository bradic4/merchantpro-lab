{
  "name": "merchantpro-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Operator toolkit for reproducible MerchantPro discovery benchmarks",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/ui',{recursive:true});fs.copyFileSync('src/ui/index.html','dist/ui/index.html');\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "ui": "tsx src/cli.ts ui"
  },
  "dependencies": {
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1",
    "puppeteer-core": "25.10.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/sharp": "^0.32.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
